; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cats"
run/main_scene="res://scenes/maps/MainScene.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/cat01.png"
config/name_pt_BR="Gatos"

[autoload]

Global="*res://scripts/Global.gd"
GameData="*res://scripts/GameData.gd"
Config="*res://scripts/Config.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1664
window/size/viewport_height=768
window/stretch/mode="2d"
window/stretch/aspect="expand"

[global]

icon=false

[gui]

timers/tooltip_delay_sec=0.2
common/show_focus_state_on_pointer_event=2
common/drop_mouse_on_gui_input_disabled=true

[input]

pause={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":0,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[internationalization]

locale/translations=PackedStringArray("res://locale/Cats translations - locale.en.translation", "res://locale/Cats translations - locale.pt_BR.translation")

[physics]

common/enable_pause_aware_picking=true

[rendering]

environment/defaults/default_clear_color=Color(0.6, 0.301961, 0.6, 1)
environment/defaults/default_environment="res://default_env.tres"
vram_compression/import_etc=true
